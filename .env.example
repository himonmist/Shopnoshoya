# PostgreSQL connection string (Neon, Vercel Postgres, Supabase, etc.)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Random 32+ character secret used to sign admin session cookies
AUTH_SECRET="change-this-to-a-long-random-string"

# Vercel Blob storage token (Vercel Dashboard -> Storage -> Blob -> Connect)
BLOB_READ_WRITE_TOKEN=""

# Initial admin account created by `npm run db:seed`
ADMIN_EMAIL="admin@shopnoshoya.org"
ADMIN_PASSWORD="change-this-password"
