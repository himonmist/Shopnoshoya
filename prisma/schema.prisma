generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

// Singleton row (id = 1) holding all editable site-wide copy.
model SiteSettings {
  id                Int      @id @default(1)
  orgName           String   @default("স্বপ্নছোঁয়া")
  orgTagline        String   @default("স্বপ্ননগর, মিরপুর-৯, ঢাকা")
  heroTitleLine1    String   @default("সকালের")
  heroTitleLine2    String   @default("ব্যায়াম,")
  heroTitleLine3    String   @default("সারাজীবনের বন্ধন")
  heroDescription   String   @default("স্বপ্ননগরের সর্বপ্রথম এবং ঐতিহ্যবাহী একটি সংগঠন — ব্যায়ামের পাশাপাশি পারস্পরিক পরিচয়, সৌহার্দ্য ও সম্প্রীতির বন্ধনে আবদ্ধ একটি পরিবার।")
  heroImage1        String   @default("/gallery/g30.jpg")
  heroImage2        String   @default("/gallery/g08.jpg")
  heroImage3        String   @default("/gallery/g16.jpg")
  announcementText  String   @default("স্বপ্নছোঁয়া'র ৪র্থ প্রতিষ্ঠা বার্ষিকী — ১৮ সেপ্টেম্বর, শুক্রবার")
  aboutText         String   @default("স্বপ্নছোঁয়া স্বপ্ননগরের সর্বপ্রথম এবং ঐতিহ্যবাহী একটি সংগঠন। এই সংগঠনের মাধ্যমেই আমরা স্বপ্ননগরবাসী ব্যায়ামের পাশাপাশি পারস্পরিক পরিচয় এবং সৌহার্দ্য ও সম্প্রীতির বন্ধনে আবদ্ধ হয়েছিলাম এবং ঐক্যবদ্ধ হয়েছিলাম স্বপ্ননগরের উন্নয়নে।")
  aboutImage        String   @default("/gallery/g24.jpg")
  committeeNote     String   @default("বর্তমান কার্যনির্বাহী কমিটির সভাপতি, সাধারণ সম্পাদক ও সদস্যদের নাম ও ছবি শীঘ্রই এখানে যুক্ত করা হবে।")
  stat1Value        String   @default("০৪")
  stat1Label        String   @default("বছরের পথচলা")
  stat2Value        String   @default("১০০+")
  stat2Label        String   @default("সক্রিয় সদস্য")
  stat3Value        String   @default("৭")
  stat3Label        String   @default("দিন, প্রতি সকাল")
  stat4Value        String   @default("১")
  stat4Label        String   @default("অভিন্ন পরিবার")
  contactAddress    String   @default("স্বপ্নছোঁয়া, স্বপ্ননগর\nআ/এ-১, মিরপুর-৯\nঢাকা-১২১৬, বাংলাদেশ")
  contactNote       String   @default("ফোন ও ইমেইল ঠিকানা শীঘ্রই এখানে যুক্ত করা হবে।")
  contactPhone      String   @default("")
  contactEmail      String   @default("")
  exerciseTimeNote  String   @default("প্রতিদিন সকাল, স্বপ্ননগর খোলা মাঠ")
  footerTagline     String   @default("স্বপ্ননগরের সর্বপ্রথম ও ঐতিহ্যবাহী ব্যায়াম সংগঠন।")
  popupEnabled      Boolean  @default(false)
  popupImageUrl     String   @default("")
  popupLinkUrl      String   @default("")
  popupTitle        String   @default("")
  updatedAt         DateTime @updatedAt
}

// Fallback image storage used when Vercel Blob isn't connected — served via
// /api/images/[id]. Small/moderate images only (see MAX_DB_IMAGE_BYTES).
model ImageAsset {
  id        String   @id @default(cuid())
  data      String
  mimeType  String
  createdAt DateTime @default(now())
}

model Activity {
  id          String   @id @default(cuid())
  category    String
  title       String
  description String
  imageUrl    String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EventItem {
  id          String   @id @default(cuid())
  title       String
  description String
  dateLabel   String
  imageUrl    String
  isUpcoming  Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GalleryImage {
  id        String   @id @default(cuid())
  url       String
  alt       String   @default("")
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Tip {
  id          String   @id @default(cuid())
  page        String   // "fitness-tips" | "healthy-lifestyle"
  badge       String   @default("")
  title       String
  description String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String
  content     String
  imageUrl    String
  tag         String    @default("")
  published   Boolean   @default(true)
  publishedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  phone     String
  subject   String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model MemberApplication {
  id        String   @id @default(cuid())
  fullName  String
  holding   String
  phone     String
  status    String   @default("pending") // pending | approved | rejected
  createdAt DateTime @default(now())
}
